{"id": "p10_mascot_fox_en", "class": "faceswap", "source": "round10-fixer", "tags": [], "brief": "Replace the actor in our 20 s clip with our company mascot, a giant orange fox (reference image attached)", "spec": {"task": "face-replace", "inputs": [{"kind": "video", "owned": true, "duration_s": 20}, {"kind": "image", "owned": true}], "outputs": ["video"], "duration_s": 20, "people": [{"name": "actor", "real": true, "public_figure": false, "consent": "stated", "claim": "none"}, {"name": "orange fox mascot", "real": false, "public_figure": false, "consent": "unknown", "claim": "none"}]}, "ref": {"outcome": "plan", "steps": [{"job": "char_replace", "models": {"any": ["wan.*animate.*", "wan-animate-replace", ".*character-replace.*", "mocha.*"], "none": [".*face-?swap.*", "inswapper.*", "facefusion.*", "roop.*"]}}], "rationale": "A mascot replaces the whole character (body, silhouette), not a face."}}
{"id": "p10_costume_ru", "class": "faceswap", "source": "round10-fixer", "tags": [], "brief": "В ролике на 15 секунд человек в ростовом костюме медведя — замените его на нашего нарисованного маскота", "spec": {"task": "face-replace", "inputs": [{"kind": "video", "owned": true, "duration_s": 15}, {"kind": "image", "owned": true}], "outputs": ["video"], "duration_s": 15, "people": [{"name": "маскот", "real": false, "public_figure": false, "consent": "unknown", "claim": "none"}]}, "ref": {"outcome": "plan", "steps": [{"job": "char_replace", "models": {"any": ["wan.*animate.*", "wan-animate-replace", ".*character-replace.*", "mocha.*"], "none": [".*face-?swap.*", "inswapper.*", "facefusion.*", "roop.*"]}}], "rationale": "Costumed character -> whole-character replacement."}}
