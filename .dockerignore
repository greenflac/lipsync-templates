.github
.claude
.ruff_cache
.mypy_cache
**/__pycache__
**/*.pyc
work/
corpus/
assets/
productions/
docs/
studio/uploads/
**/*.sqlite3
studio/knowledge/gallery_prompts.jsonl
studio/knowledge/civitai_prompts.jsonl
.env
deploy/.env
deploy/secrets/
