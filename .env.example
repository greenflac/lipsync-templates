# ОБРАЗЕЦ. Скопировать в .env на машине прогона и вписать настоящие значения.
# .env закрыт .gitignore и в репозиторий не попадает. Ключи живут только в
# переменных окружения: попавший в git ключ считается скомпрометированным.
#
#   cp .env.example .env      # потом вписать ключи
#   set -a; . ./.env; set +a  # подхватить в текущую оболочку

# ВСЕ ключи ниже открывают ПЛАТНЫЕ вызовы. Бесплатной ступени в этом
# пайплайне нет. Раньше здесь было написано, что платная только fal.ai —
# это неверно, и на этом основании 2026-08-26 был сделан лишний оплаченный
# вызов к pollinations. Комментарий, из которого можно вывести «значит, вот
# это бесплатно», стоит дороже, чем отсутствие комментария.

# fal.ai — очередь Kling Motion Control (ступень 6). ПЛАТНО, дороже всего:
# по studio/CONTRACTS.md одно видео ≈ $0.70.
FAL_KEY=

# pollinations.ai — шлюз к моделям генерации, эстетики и сборка рефок
# (ступени 2 и 4). ПЛАТНО: это клиент к платным моделям, а не бесплатный
# сервис. Каждый вызов image()/images_edit()/compose() тратит деньги.
POLLINATIONS_API_KEY=
