#!/usr/bin/env bash
# Гейт перед пушем: то же, что гоняет CI, но до того, как ветка уехала.
#
# ЗАЧЕМ. 2026-09-02 дважды подряд красный CI по одной причине: коммит уехал
# без прогона `scripts/check`.
#
#   a202981  в коммит попала НЕПОЛНАЯ очередь портала  -> exit 2
#   17566b2  хэндоф вырос до 414 строк при потолке 400  -> exit 1
#
# Оба поймал бы локальный прогон за 85 секунд. Цена красного CI выше: чужое
# время в очереди сборки, уведомление, отдельный коммит-починка и ветка,
# которая какое-то время стоит красной для всех, кто на неё смотрит.
#
# ЧЕМ ЭТО НЕ ЯВЛЯЕТСЯ. Это НЕ гейт (Ц7): хук лежит вне `.git/hooks`, в свежем
# клоне не включён, обходится `--no-verify`. Настоящий заслон — CI, и он
# остаётся. Это заслон от невнимательности, и он честно говорит о себе.
#
# ИМЕНА ПЕРЕМЕННЫХ ЗДЕСЬ ЛАТИНИЦЕЙ, В ОТЛИЧИЕ ОТ ОСТАЛЬНОГО КОДА ПРОЕКТА:
# bash не принимает кириллицу в имени переменной и молча разбирает
# `корень="..."` как ИМЯ КОМАНДЫ. Хук при этом не падал — он печатал
# «scripts/check не найден» и пропускал push. Поймано прогоном хука на
# заведомо красном гейте (П3): заслон, который сам себя не проверил,
# защищает ровно ничего.
#
# ВКЛЮЧИТЬ:  git config core.hooksPath .githooks
# ОБОЙТИ:    git push --no-verify   — и по правилу Ц8 сказать в отчёте, почему.

set -u
root="$(git rev-parse --show-toplevel)"
if [ ! -x "$root/scripts/check" ] && [ ! -f "$root/scripts/check" ]; then
    echo "pre-push: scripts/check не найден — пропускаю (это не гейт)"
    exit 0
fi

echo "pre-push: гоняю scripts/check (около 85 с) ..."
if bash "$root/scripts/check" > /tmp/pre-push-check.log 2>&1; then
    echo "pre-push: гейт зелёный, пушу"
    exit 0
fi

rc=$?
echo
echo "pre-push: ГЕЙТ КРАСНЫЙ (exit $rc). Пуш остановлен."
echo "  Полный вывод: /tmp/pre-push-check.log"
echo "  Последние строки:"
tail -20 /tmp/pre-push-check.log | sed 's/^/    /'
echo
echo "  Починить и повторить — или, если push нужен намеренно:"
echo "      git push --no-verify"
echo "  и сказать в отчёте, почему (правило Ц8: отступление записывается)."
exit 1
