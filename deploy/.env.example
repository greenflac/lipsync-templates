# /srv/studio/.env - the owner's settings for deploy/compose.yaml. No secrets here: the
# secrets are files in /srv/studio/secrets (written by vps-bootstrap.sh).

# The domain whose DNS A record points at this VPS (the same IPv4 as harness.greenflac.online).
# The harness Caddy issues its certificate.
STUDIO_DOMAIN=studio.greenflac.online

# The address the harness Caddy listens on: the value of HARNESS_BIND_IP in
# /srv/harness/.env, or 127.0.0.1 when that is 0.0.0.0 or empty. release.sh probes
# https://STUDIO_DOMAIN resolved to this address. The `studio` user cannot read the
# harness .env, so the value is copied here.
STUDIO_PROBE_IP=127.0.0.1

# The loopback port the server is also published on, for the owner's checks on the VPS.
STUDIO_LOCAL_PORT=8770

# Where the secret files are. Change only for a test run on another machine.
STUDIO_SECRETS_DIR=/srv/studio/secrets

# Where releases come from. release.sh refuses any other repository.
STUDIO_IMAGE_REPO=ghcr.io/greenflac/lipsync-templates
