# /srv/studio/.env - the owner's settings for deploy/compose.yaml. No secrets here: the
# secrets are files in /srv/studio/secrets (written by vps-bootstrap.sh).

# The domain whose DNS A record points at the VPS. TLS is issued for it.
STUDIO_DOMAIN=studio.greenflac.online

# `tls` = this compose runs its own Caddy on 80/443 (a VPS of its own).
# Empty = the harness Caddy on the same VPS serves the domain (deploy/Caddyfile.harness-site).
COMPOSE_PROFILES=tls

# The address Let's Encrypt writes to about the certificate (own Caddy only).
ACME_EMAIL=owner@example.com

# Where Caddy publishes 80 and 443 (own Caddy only). 0.0.0.0 = every address.
STUDIO_BIND_IP=0.0.0.0

# The loopback port the server is published on (the harness Caddy proxies to it).
STUDIO_LOCAL_PORT=8770

# Where the secret files are. Change only for a test run on another machine.
STUDIO_SECRETS_DIR=/srv/studio/secrets

# Where releases come from (release.sh refuses any other repository).
STUDIO_IMAGE_REPO=ghcr.io/greenflac/lipsync-templates
