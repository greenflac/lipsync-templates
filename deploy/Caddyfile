# Caddy in front of the studio connector (own-VPS layout, compose profile `tls`).
# Copied from green-harness deploy/Caddyfile: automatic TLS for STUDIO_DOMAIN (Let's Encrypt),
# HSTS and security headers, and only the server's own paths proxied
# (studio/mcp/tests/test_connector_deploy.py keeps this list equal to the app's routes).
{
	email {$ACME_EMAIL}
	admin off
	servers {
		protocols h1 h2
	}
}

{$STUDIO_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}

	request_body {
		max_size 2MB
	}

	@app path /mcp /mcp/* /healthz /.well-known/oauth-authorization-server /.well-known/oauth-protected-resource/mcp /register /authorize /token /revoke /oauth/login
	handle @app {
		reverse_proxy server:8770
	}
	handle {
		respond "not found" 404
	}

	log {
		output stdout
		format json
	}
}
