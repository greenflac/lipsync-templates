#!/usr/bin/env bash
# Single source of truth for all checks: CI runs this same script.
set -euo pipefail
cd "$(dirname "$0")/.."

# ДЛИТЕЛЬНОСТЬ ШАГА ПЕЧАТАЕТСЯ. Правило дома П2 требует этого прямым текстом
# («дешёвые проверки раньше дорогих, длительность шагов печатается»), и до
# 2026-09-02 гейт его же и нарушал: 58 шагов, ни одной цифры. Пока прогон
# стоил полминуты, это было терпимо; сегодня он вырос до 91 с локально и 216 с
# в CI, и вопрос «какой шаг столько ест» стало нечем задать.
#
# ИМЕНА ЗДЕСЬ ЛАТИНИЦЕЙ, В ОТЛИЧИЕ ОТ ОСТАЛЬНОГО КОДА ПРОЕКТА: bash не
# принимает кириллицу в имени переменной и молча разбирает `ШАГ=""` как имя
# КОМАНДЫ. Это уже ловилось сегодня на `.githooks/pre-push` — и повторилось
# здесь через шесть часов, потому что правило было записано в комментарии
# ТОГО файла, а не там, где пишут следующий скрипт.
#
# Время печатается ПОСЛЕ шага, отдельной строкой: держать его до конца шага
# значило бы потерять при падении, то есть ровно там, где оно нужнее всего.
_step_start=""
_step_name=""
_all_start=$(date +%s)
_marks=""

_close_step() {
  [ -z "$_step_name" ] && return 0
  local sec=$(( $(date +%s) - _step_start ))
  _marks="${_marks}${sec} ${_step_name}"$'\n'
  if [ "$sec" -ge 3 ]; then echo "   ($sec с)"; fi
  return 0
}

step() {
  _close_step
  _step_name="$1"
  _step_start=$(date +%s)
  echo "== $1"
}

# Итог печатается ВСЕГДА, в том числе при падении: время, потраченное до
# провала, — часть отчёта о провале (П2), а не украшение успеха.
_time_summary() {
  _close_step
  echo
  echo "время: всего $(( $(date +%s) - _all_start )) с; самые дорогие шаги:"
  printf '%s' "$_marks" | sort -rn | head -5 | sed 's/^/   /'
}
trap _time_summary EXIT

# ПЕРВЫМ ШАГОМ — САМЫЙ ДЕШЁВЫЙ И САМЫЙ ОБИДНЫЙ (П2). 2026-09-05 в репозиторий
# уехал снимок убитого мутационного прогона: `if False:` вместо решения в
# `scripts/recheck_vendor.py`. Гейт это ловил — но через 70 с тестов и под
# подписью «упал test_recheck_vendor», по которой утечка не читается. Здесь
# она называется вслух за миллисекунды.
step "мутанты не утекли в дерево"
python scripts/check_mutants_clean.py

step "ruff check"
ruff check lipsync/

step "ruff format"
ruff format --check lipsync/

step "mypy"
python -c "import mypy" 2>/dev/null || { echo "FAIL: mypy is not installed"; exit 1; }
python -m mypy lipsync/ --ignore-missing-imports

step "tests"
# ЗАПРЕТ СЕТИ ДЕРЖИТ РАННЕР, А НЕ ДОГОВОРЁННОСТЬ (правило Т4, критерий R8).
# ИЗМЕРЕНО 2026-09-04: запрет держали 16 файлов из 107 своими руками — значит
# новый тест, открывший сокет, не заметил бы никто. `scripts/run_tests.py`
# ставит запрет до импорта тестов, сам проверяет его негативным контролем и
# только потом зовёт `unittest discover`. Прибор оправдался на первом же
# прогоне: `test_a_string_probe_must_carry_the_sentinel` уходил в настоящий
# вызов вендорского API — сетевой в тесте и ПЛАТНЫЙ.
python scripts/run_tests.py lipsync/tests

# The Self-RAG prompt engineer. Gated here rather than described in a document,
# because a rule that is only written down is a rule that gets skipped under a
# deadline and leaves no trace in the diff.
#
# Only studio/selfrag is checked, not all of studio/: the rest of the studio
# suite needs httpx2, which requirements-dev.txt does not pin, so adding it here
# would turn a missing dependency into a red build for everybody. That gap is
# reported to the owner of requirements-dev.txt rather than papered over.
step "ruff check (selfrag)"
ruff check studio/selfrag/

step "ruff format (selfrag)"
ruff format --check studio/selfrag/

step "mypy (selfrag)"
MYPYPATH=. python -m mypy --explicit-package-bases studio/selfrag/ --ignore-missing-imports

step "tests (selfrag)"
python scripts/run_tests.py studio/selfrag/tests

# The calibration path. Lint and types are still named file by file (they are
# per-module tools); the tests below are gated by directory.
#
# Leaving these ungated had already cost something — a commit landed with the
# `verify()` invariant failing in two tests and CI stayed green, because the
# gate could not see the file (OBSERVED 2026-08-26).
step "ruff check (calibration)"
ruff check studio/prompt_templates.py studio/tests/test_prompt_templates.py \
    studio/tests/test_calibration_contract.py

step "ruff format (calibration)"
ruff format --check studio/prompt_templates.py studio/tests/test_prompt_templates.py \
    studio/tests/test_calibration_contract.py

step "mypy (calibration)"
MYPYPATH=. python -m mypy --explicit-package-bases studio/prompt_templates.py \
    studio/tests/test_prompt_templates.py studio/tests/test_calibration_contract.py \
    --ignore-missing-imports

# Т6, ИЗМЕРЕНО 2026-09-02: гейт называл модули studio/tests поимённо, и семи
# файлов не называл никто — 127 тестов, которые существуют и никогда не
# гонялись гейтом: test_app, test_jobs, test_ledger, test_lifecycle,
# test_store, test_style, test_vector_cache. Среди них тесты модуля,
# написанного в тот же день. Поимённый список — это второй способ узнать,
# какие тесты есть (Е1), и он разъехался молча: «не запускалось» выглядело
# как «прошло». Мешал перебору один недостающий __init__.py и один
# незаявленный пакет (httpx2, см. requirements-dev.txt); оба заведены.
step "tests (studio/tests целиком)"
python scripts/run_tests.py studio/tests

# Ц7: правило «завёл тест — впиши его в гейт» словами не держится, и не
# держалось: семь файлов существовали и не гонялись. Проверка перечисляет
# файлы тестов в дереве и требует, чтобы каждый был достижим — перебором
# каталога или поимённым списком. Свой негативный контроль печатает первой
# строкой: «нарушений 0» без него может значить «ничего не искали».
step "тесты, которых гейт не запускает"
python scripts/check_tests_gated.py

# The template lint. Its tests run in the directory sweep above; what is named
# here is lint and types. The suite was ungated until 2026-08-27, and the
# provenance defect it now covers had been sitting in the loader.
step "ruff check (lint)"
ruff check studio/template_lint.py studio/tests/test_template_lint.py \
    studio/tests/test_lint_contract.py studio/fixtures/lint_control_set.py

step "ruff format (lint)"
ruff format --check studio/template_lint.py studio/tests/test_template_lint.py \
    studio/tests/test_lint_contract.py studio/fixtures/lint_control_set.py

step "mypy (lint)"
MYPYPATH=. python -m mypy --explicit-package-bases studio/template_lint.py \
    studio/tests/test_template_lint.py studio/tests/test_lint_contract.py \
    studio/fixtures/lint_control_set.py --ignore-missing-imports

# The retriever scored against its gold set, with the negative controls that
# make the score mean anything. Exit code 2 is "could not measure" and is a
# red build here on purpose: a corpus that vanished must not read as green.
step "selfrag retrieval eval"
python -m studio.selfrag --state :memory: eval

# The chat agent: the MCP server the owner talks to, its contract gate, its
# prompt writer and its knowledge consultant.
#
# The tests are unittest.TestCase and not pytest functions on purpose: this
# script is the gate, it runs `unittest discover`, and pytest is not pinned in
# requirements-dev.txt. Test functions the runner cannot collect are tests that
# do not exist, and this repository has already paid for that once.
step "ruff check (mcp)"
ruff check studio/mcp/

step "ruff format (mcp)"
ruff format --check studio/mcp/

step "mypy (mcp)"
MYPYPATH=. python -m mypy --explicit-package-bases studio/mcp/ --ignore-missing-imports

# Приборы гейта — тоже код, и до сих пор их типы не проверял никто: на
# 2026-09-04 здесь лежало 36 ошибок в 8 файлах, среди них настоящая —
# `advice.withdraw(**row)` подавал словарь в подпись, первый именованный
# параметр которой `path`. Флаг `--no-namespace-packages` обязателен и не
# косметика: рядом лежат модуль `studio/knowledge.py` и каталог с данными
# `studio/knowledge/`, и в режиме namespace-пакетов проверка выбирает
# каталог, тогда как импорт в рантайме выбирает модуль — обычный модуль
# сильнее namespace-пакета. Без флага получаем 13 выдуманных ошибок о
# «нет атрибута» в `eval_corpus.py`.
step "mypy (scripts)"
MYPYPATH=. python -m mypy --no-namespace-packages scripts/ --ignore-missing-imports

step "tests (mcp)"
python scripts/run_tests.py studio/mcp/tests

# The server has to actually start and speak the protocol. Importing it proves
# nothing: the tools are registered by decorator at import time, so an import
# succeeds even when the transport is broken.
# The fact tiers live in studio/selfrag/facts.py and are covered by the mcp
# suite above (test_fetch_probe), which studio/mcp depends on: a `probe` tier
# was added, and adding it surfaced an unrecognised tier reaching `pass` — it
# sorted worse than `blog`, but the "is this only blogs" check compared by
# name, so a typo'd tier sailed past.
#
# The blind control set: 54 cases written by an agent that was forbidden to read
# the implementation and judged it from the contracts alone (house rule И1). It
# found three real defects on 2026-08-27 — a corpus colour added to a palette the
# owner had already filled, saturation refused even when corroborated, and an
