python studio/mcp/fixtures/blind_control_set.py

# The reading pass, asserted rather than trusted. Reads the fact file only --
# no network, so this stays honest in CI: it fails if a claim scripts/read_sources.py
# withdrew has come back, or if a reading it recorded has been edited away.
step "reading pass still applied"
python scripts/read_sources.py --check

# The harvest, asserted rather than trusted. Reads the fact file and the
# harvest file only -- no network -- and fails if a row is malformed or if the
# harvest has drifted out of the base.
# The access request must not silently drop a domain. A refused host in
# neither a tier nor the exclusions would just vanish from the generated
# request -- which is exactly how a needed vendor fails to get whitelisted.
# Does every declared vendor still have a way in that needs no whitelist
# entry? Red here means a vendor really has been walled off -- which is
# the only kind of access request worth making.
step "every vendor family has an open route"
python - <<'PY'
import sys
from studio.mcp import routes
out = routes.blocked_families()
print(out["note"])
sys.exit(0 if out["outcome"] == "pass" else 1)
PY

